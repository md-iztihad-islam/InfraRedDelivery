                <Circle fx:id="atOurWareHouse" fill="#eceff2" layoutX="152.0" layoutY="281.0" radius="13.0" stroke="BLACK" strokeType="INSIDE" />
                <Circle fx:id="deliveryManAssigned" fill="#eceff2" layoutX="301.0" layoutY="280.0" radius="13.0" stroke="BLACK" strokeType="INSIDE" />
                <Circle fx:id="onYourWay" fill="#eceff2" layoutX="489.0" layoutY="280.0" radius="13.0" stroke="BLACK" strokeType="INSIDE" />
                <Circle fx:id="delivered" fill="#eceff2" layoutX="654.0" layoutY="282.0" radius="13.0" stroke="BLACK" strokeType="INSIDE" />

                <Label layoutX="106.0" layoutY="313.0" text="At Our Warehouse" />
                <Label layoutX="245.0" layoutY="314.0" text="Delivery Man Assigned" />
                <Label layoutX="449.0" layoutY="313.0" text="On Your Way!" />
                <Label layoutX="628.0" layoutY="312.0" text="Delivered" />
