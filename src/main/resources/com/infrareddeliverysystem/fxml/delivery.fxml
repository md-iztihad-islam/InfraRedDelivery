                <Label fx:id="receiverName" layoutX="149.0" layoutY="65.0" text="Receiver" />
                <Label layoutX="23.0" layoutY="114.0" styleClass="field-label" text="Receiver Phone" />
                <Label fx:id="receiverPhone" layoutX="150.0" layoutY="110.0" text="Phone" />
                <Label layoutX="24.0" layoutY="165.0" styleClass="field-label" text="Address" />
                <Label fx:id="address" layoutX="150.0" layoutY="156.0" text="Address" />

                <Label layoutX="400.0" layoutY="30.0" styleClass="field-label" text="Parcel Description" />
                <Label fx:id="parDes" layoutX="595.0" layoutY="29.0" text="Red Rose" />
                <Label layoutX="400.0" layoutY="65.0" styleClass="field-label" text="Total Payable Amount" />
                <Label fx:id="total" layoutX="609.0" layoutY="64.0" text="5000" />
                <Label layoutX="400.0" layoutY="104.0" styleClass="field-label" text="Payment Status" />
                <Label fx:id="paymentStatus" layoutX="599.0" layoutY="100.0" text="Unpaid" />
