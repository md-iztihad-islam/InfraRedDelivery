<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.infrareddeliverysystem.controllers.ChatRider">
    <children>
        <Label layoutX="20" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Rider Chat" />
        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" layoutX="20" layoutY="60" prefHeight="420" prefWidth="760" styleClass="chat-scroll">
            <content>
                <VBox fx:id="chatVBox" prefWidth="740" spacing="10" />
            </content>
        </ScrollPane>
        <TextField fx:id="messageField" layoutX="20" layoutY="500" prefWidth="650" promptText="Type your message..." />
        <Button fx:id="sendButton" layoutX="690" layoutY="500" onAction="#onSend" prefWidth="90" text="Send" />
      <Button fx:id="menuButton" layoutX="365.0" layoutY="552.0" mnemonicParsing="false" onAction="#onBackButton" text="Back" />
    </children>
</AnchorPane>
