<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.infrareddeliverysystem.controllers.Welcometochatrider"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@style.css">
    <children>
        <Label fx:id="welcomeLabel"
               layoutX="60.0" layoutY="200.0"
               prefWidth="680.0" prefHeight="100.0"
               alignment="CENTER"
               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"
               text="Welcome to InfraRed Chatting System"
               opacity="0"/>
        <Button fx:id="chatNowButton"
                layoutX="325.0" layoutY="340.0"
                prefWidth="150.0" prefHeight="50.0"
                text="Chat Now"
                styleClass="button"
                opacity="0"
                onAction="#onChatNow"/>
    </children>
</AnchorPane>